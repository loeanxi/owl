#!/bin/sh

# Get list of staged files before running check
STAGED_FILES=$(git diff --cached --name-only)

node scripts/check-lockfile-commit.mjs
if [ $? -ne 0 ]; then
  exit 1
fi

# Run the check script (formatting, linting, and type checking)
echo "Running formatting, linting, and type checking..."
npm run check
if [ $? -ne 0 ]; then
  echo "❌ Checks failed. Please fix the errors before committing."
  exit 1
fi

# The browser smoke branch is intentionally absent: it called `npm run check:browser-smoke`,
# which no root script defines, and the underlying scripts/check-browser-smoke.mjs targets
# upstream packages this fork does not ship (@earendil-works/pi-client, pi-protocol,
# packages/durable). Any commit touching packages/ai would fail unconditionally.
# `npm run check` below already covers formatting, linting, and type checking.

# Restage files that were previously staged and may have been modified by formatting
for file in $STAGED_FILES; do
  if [ -f "$file" ]; then
    git add "$file"
  fi
done

echo "✅ All pre-commit checks passed!"
