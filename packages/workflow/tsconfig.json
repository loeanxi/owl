{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2022"],
		"strict": true,
		"declaration": true,
		"sourceMap": true,
		"outDir": "dist",
		"rootDir": "src",
		"skipLibCheck": true,
		"allowJs": false,
		"types": ["node"]
	},
	"include": ["src/**/*.ts"],
	"exclude": ["vendor", "dist"]
}
