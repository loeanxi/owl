{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "pire",
	"version": "0.1.0",
	"identifier": "dev.pire.desktop",
	"build": {
		"beforeDevCommand": "npm run dev",
		"devUrl": "http://localhost:5188",
		"beforeBuildCommand": "npm run build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "pire",
				"width": 1280,
				"height": 860,
				"resizable": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": ["nsis"],
		"icon": []
	}
}
