{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "owl",
	"version": "0.1.0",
	"identifier": "dev.owl.desktop",
	"build": {
		"beforeDevCommand": "npm run dev",
		"devUrl": "http://localhost:5188",
		"beforeBuildCommand": "npm run build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": ["nsis"],
		"icon": ["icons/icon.ico"],
		"resources": [
			"D:/owl/owl-re-v1/owl-mono/packages/coding-agent/dist/**"
		],
		"windows": {
			"nsis": {
				"installMode": "currentUser",
				"languages": ["SimpChinese", "English"],
				"displayLanguageSelector": false
			}
		}
	}
}
