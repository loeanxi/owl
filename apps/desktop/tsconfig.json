{
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"useDefineForClassFields": true,
		"types": ["vite/client"]
	},
	"include": ["src", "../../coding-agent/src/modes/desktop/protocol.ts"],
	"exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
