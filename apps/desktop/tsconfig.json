{
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"useDefineForClassFields": true,
		"types": ["vite/client"]
	},
	"include": [
		"src",
		"../../packages/coding-agent/src/modes/desktop/protocol.ts",
		// 高亮库只有根入口带 types，子路径导入靠这份环境声明；它必须进 program 才生效。
		"../../packages/coding-agent/src/utils/highlight-js.d.ts"
	],
	"exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
